<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2023.09.02</Version>
    <Title>yunggh</Title>
    <Description>This library open source library contains useful Grasshopper components.</Description>
    <Product>yunggh</Product>
    <Copyright>Copyright © 2022</Copyright>
    <TargetExt>.gha</TargetExt>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>RH8;RH7</Configurations>
    <SignAssembly>False</SignAssembly>
    <RootNamespace>yunggh</RootNamespace>
    <AssemblyName>yunggh</AssemblyName>
    <ComVisible>false</ComVisible>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="4.7.1" />
    <PackageReference Include="Google.Apis" Version="1.42.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.42.0" />
    <PackageReference Include="Google.Apis.Core" Version="1.42.0" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.42.0.1791" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='RH7|AnyCPU'">
    <TargetFramework>net48</TargetFramework>
    <OutputPath>C:\Users\$(USERNAME)\AppData\Roaming\Grasshopper\6\Libraries\yunggh\</OutputPath>
    <StartProgram>C:\Program Files\Rhino 7\System\Rhino.exe</StartProgram>
    <StartArguments></StartArguments>
    <StartAction>Program</StartAction>
    <DebugType>Full</DebugType>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Rhino 8 target: plain net7.0, NOT net7.0-windows.

       net7.0-windows produces a Windows-only assembly, which is why the package
       could only ever be published as '-win' and never showed up in the Package
       Manager on macOS. Plain net7.0 builds one .gha that loads on Rhino 8 for
       both Windows and Mac, so yak can publish it for the 'any' platform.

       The WinForms code in the plugin (component right-click menus) still works:
       Rhino 8 ships its own System.Windows.Forms and System.Drawing
       implementations on macOS. We only need the *reference* assemblies at
       compile time - see the RH8 ItemGroup below. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='RH8|AnyCPU'">
    <TargetFramework>net7.0</TargetFramework>
    <OutputPath>C:\Users\$(USERNAME)\AppData\Roaming\Grasshopper\6\Libraries\yunggh\</OutputPath>
    <StartProgram>C:\Program Files\Rhino 8\System\Rhino.exe</StartProgram>
    <StartArguments></StartArguments>
    <StartAction>Program</StartAction>
    <DebugType>portable</DebugType>
    <!-- The Grasshopper 8.0 package only ships lib/net48. Consuming those
         reference assemblies from net7.0 is what Rhino 8 plugins are expected
         to do; NU1701 just notes the framework mismatch. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)|$(Platform)'=='RH7|AnyCPU'">
    <PackageReference Include="Grasshopper" Version="7.0.20314.3001" ExcludeAssets="all" />
    <Reference Include="RhinoCommon">
      <HintPath>C:\Program Files\Rhino 7\System\RhinoCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Grasshopper">
      <HintPath>C:\Program Files\Rhino 7\Plug-ins\Grasshopper\Grasshopper.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>C:\Program Files\Rhino 7\Plug-ins\Grasshopper\GH_IO.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Forms">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)|$(Platform)'=='RH8|AnyCPU'">
    <!-- Compile against the 8.0 NuGet package rather than the locally installed
         Rhino, so yak tags the package rh8_0 (installable on any Rhino 8) instead
         of pinning it to whatever service release this machine happens to have.
         ExcludeAssets="runtime" keeps RhinoCommon/Grasshopper/GH_IO out of the
         build output - Rhino supplies them at load time. -->
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />

    <!-- System.Windows.Forms and System.Drawing are not part of the plain net7.0
         framework, but Rhino 8 provides both at runtime on Windows *and* macOS.
         So we reference them for compilation only and ship neither:
           ExcludeAssets="runtime" - don't copy System.Drawing.Common.dll
           ExcludeAssets="all"     - don't copy anything from the ref pack
           Private="False"         - don't copy System.Windows.Forms.dll
         Pulling the WinForms ref assembly out of Microsoft.WindowsDesktop.App.Ref
         is the approach McNeel recommends for cross-platform Rhino 8 plugins. -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.WindowsDesktop.App.Ref" Version="7.0.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <Reference Include="$(PkgMicrosoft_WindowsDesktop_App_Ref)\ref\net7.0\System.Windows.Forms.dll" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Core">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Data">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Drawing">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Xml">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="System.Xml.Linq">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
